# syntax=docker/dockerfile:1
# Frontend PWA: build Vite + serve estático con nginx. No-root, HEALTHCHECK.

FROM node:22.12.0-alpine AS builder
WORKDIR /srv
COPY package.json package-lock.json* ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.node.json tailwind.config.js postcss.config.js nginx.conf ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM nginx:1.27.3-alpine AS runtime
RUN adduser -D -u 10001 appuser
COPY --from=builder /srv/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# nginx no-root: el pid va a /tmp porque /var/run no es escribible por appuser
# (el unlink del pid fallaba con Permission denied al reiniciar).
RUN sed -i 's|pid[[:space:]]*/var/run/nginx.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && grep -q 'pid /tmp/nginx.pid;' /etc/nginx/nginx.conf \
    && chown -R appuser /var/cache/nginx /usr/share/nginx/html
USER appuser
EXPOSE 80
# 127.0.0.1 explícito: "localhost" puede resolver a IPv6 y nginx escucha IPv4.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
