# Copiar a .env y completar valores reales. NUNCA commitear .env con secretos (R10, spec 1.2).
# Este archivo solo contiene placeholders, jamás credenciales (RN-SE-04).

# Postgres del compose (owner para DDL/seed + password del rol app restringido)
POSTGRES_USER=usuario_owner
POSTGRES_PASSWORD=cambiar-por-aleatorio
POSTGRES_DB=turnos
APP_DB_PASSWORD=cambiar-por-aleatorio-distinto

# PostgreSQL async (driver asyncpg en api/worker; ver alembic.ini para URL sync de migraciones)
DATABASE_URL=postgresql+asyncpg://usuario_app:contrasena@db:5432/turnos
# Rol owner para Alembic + seed (D4: el rol app solo tiene INSERT+SELECT en auditoria)
DATABASE_URL_OWNER=postgresql+asyncpg://usuario_owner:contrasena@db:5432/turnos
# Redis (colas / caché)
REDIS_URL=redis://redis:6379/0
# JWT (requerida: arrancar sin ella falla nombrando la variable)
JWT_SECRET=cambiar-por-aleatorio-de-32-caracteres-como-minimo
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=30
# Mercado Pago (C-12; placeholders hasta configurar)
MP_ACCESS_TOKEN=APP_USR-PLACEHOLDER
MP_WEBHOOK_SECRET=PLACEHOLDER
# WhatsApp Cloud API (C-08; placeholders hasta configurar)
WA_API_TOKEN=PLACEHOLDER
WA_PHONE_ID=PLACEHOLDER
WA_WEBHOOK_TOKEN=PLACEHOLDER
# Email transaccional
SMTP_URL=smtp://mailhog:1025
# Frontend público (links en emails/mensajes)
FRONT_URL=http://localhost:5173
# Tenant piloto del seed
TENANT_SLUG_DEFAULT=consultorio-piloto
